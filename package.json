{
  "name": "dashboard-hypezone",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:dev": "ng serve --configuration development",
    "start:prod": "ng serve --configuration production",
    "build": "ng build",
    "build:dev": "ng build --configuration development",
    "build:prod": "ng build --configuration production",
    "seed:firebase:dev": "node scripts/seed-firebase-dev-roles.cjs --project hypezone-dev",
    "seed:firebase:prod": "node scripts/seed-firebase-prod-roles.cjs --project hypezone-3ed2a",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "firebase:use:dev": "firebase use dev",
    "firebase:use:prod": "firebase use prod",
    "functions:build": "npm --prefix functions run build",
    "deploy:dev": "npm run build:dev && npm run functions:build && firebase use dev && firebase deploy --only firestore:rules,functions,hosting",
    "deploy:prod": "npm run build:prod && npm run functions:build && firebase use prod && firebase deploy --only firestore:rules,functions,hosting",
    "deploy:prod:rules": "firebase use prod && firebase deploy --only firestore:rules",
    "deploy:prod:functions": "npm run functions:build && firebase use prod && firebase deploy --only functions",
    "deploy:prod:hosting": "npm run build:prod && firebase use prod && firebase deploy --only hosting",
    "emulators": "firebase emulators:start"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.25",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/fire": "^20.0.1",
    "@angular/forms": "^20.3.0",
    "@angular/material": "^20.2.14",
    "@angular/platform-browser": "^20.3.0",
    "@angular/platform-browser-dynamic": "^20.3.25",
    "@angular/router": "^20.3.0",
    "firebase": "^11.10.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.31",
    "@angular/cli": "^20.3.31",
    "@angular/compiler-cli": "^20.3.0",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.2"
  }
}
