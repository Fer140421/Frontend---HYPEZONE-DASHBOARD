// DEV & PROD authorization rules with public read access for active store products/catalogs.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function activeUser() { return signedIn() && profile().data.active == true; }
    function hasPermission(permission) {
      return activeUser() && profile().data.effectivePermissions[permission] == true;
    }

    // A user may read their own profile. The administrative list requires the
    // server-materialized users.view permission. No client can mutate profiles.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || hasPermission('users.view'));
      allow create, update, delete: if false;
    }

    // AuthService needs the active role document to resolve the session.
    match /roles/{roleId} {
      allow read: if activeUser();
      allow write: if false;
    }

    // Internal full products collection (contains private buying costs & internal notes)
    match /productos/{id} {
      allow read: if hasPermission('products.view');
      allow create: if hasPermission('products.create');
      allow update: if hasPermission('products.update');
      allow delete: if hasPermission('products.delete');
    }

    // Public sanitized mirror collection for online store (NO buying prices, NO internal notes)
    match /productosPublicos/{id} {
      allow read: if resource.data.activo == true || hasPermission('products.view');
      allow create: if hasPermission('products.create');
      allow update: if hasPermission('products.update');
      allow delete: if hasPermission('products.delete');
    }

    // Discount campaigns only change the public offer already mirrored on products.
    match /descuentos/{id} {
      allow read: if hasPermission('products.view');
      allow create, update, delete: if hasPermission('products.update');
    }

    match /clientes/{id} {
      allow read: if hasPermission('clients.view');
      allow create: if hasPermission('clients.create');
      allow update: if hasPermission('clients.update') || (
        hasPermission('sales.create') &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'puntosDisponibles', 'puntosAcumulados', 'recompensasDisponibles', 'updatedAt'
        ])
      );
      allow delete: if hasPermission('clients.delete');
    }

    match /configuracion/{id} {
      allow read: if hasPermission('settings.view') || hasPermission('sales.create');
      allow create, update: if hasPermission('settings.view');
      allow delete: if false;
    }

    match /ventas/{id} {
      allow read: if hasPermission('sales.view');
      allow create: if hasPermission('sales.create');
      allow update: if hasPermission('sales.update');
      allow delete: if false;
    }

    match /operacionesVenta/{id} {
      allow read: if hasPermission('sales.view');
      allow create: if hasPermission('sales.create');
      allow update: if hasPermission('sales.update');
      allow delete: if false;
    }

    match /reservas/{id} {
      allow read: if hasPermission('sales.view');
      allow create: if hasPermission('sales.create');
      allow update: if hasPermission('sales.update');
      allow delete: if false;
    }

    match /lotes/{id} {
      allow read: if hasPermission('lots.view');
      allow create: if hasPermission('lots.create');
      allow update: if hasPermission('lots.update');
      allow delete: if hasPermission('lots.delete');
    }

    match /proveedores/{id} {
      allow read: if hasPermission('providers.view');
      allow create: if hasPermission('providers.create');
      allow update: if hasPermission('providers.update');
      allow delete: if hasPermission('providers.delete');
    }

    // Public read for catalog filters (online store) + protected administrative CRUD
    match /categorias/{id} {
      allow read: if resource.data.activo != false || hasPermission('catalogs.view');
      allow create: if hasPermission('catalogs.create');
      allow update: if hasPermission('catalogs.update');
      allow delete: if hasPermission('catalogs.delete');
    }

    match /marcas/{id} {
      allow read: if resource.data.activo != false || hasPermission('catalogs.view');
      allow create: if hasPermission('catalogs.create');
      allow update: if hasPermission('catalogs.update');
      allow delete: if hasPermission('catalogs.delete');
    }

    match /tallas/{id} {
      allow read: if resource.data.activo != false || hasPermission('catalogs.view');
      allow create: if hasPermission('catalogs.create');
      allow update: if hasPermission('catalogs.update');
      allow delete: if hasPermission('catalogs.delete');
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
